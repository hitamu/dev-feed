---
import Day from '../components/Day.astro';
import { days, totalItems } from '../lib/items.js';

const dates = days();
const total = dates.length;
const count = totalItems();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>devfeed — nhật ký lập trình</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="masthead">
      <p class="issue">{total} ngày · cập nhật hàng ngày</p>
      <h1 data-text="devfeed">devfeed</h1>
      <p class="count">{count} bài · {total} ngày</p>
    </header>

    <main id="feed">
      {dates[0] && <Day date={dates[0]} n={1} />}
    </main>

    {total > 1 && <div id="sentinel">Đang tải…</div>}

    <footer>devfeed · <span id="foot-year"></span> · nhật ký nguồn kỹ thuật</footer>

    <script define:vars={{ total, base }}>
      document.getElementById('foot-year').textContent = String(
        new Date().getFullYear()
      );

      const feed = document.getElementById('feed');
      const sentinel = document.getElementById('sentinel');
      let next = 2;
      let loading = false;

      // Fold/collapse toggle via event delegation
      feed.addEventListener('click', (e) => {
        const head = e.target.closest('.day-head, .group-head, .source-head');
        if (!head) return;
        const container = head.closest('.day, .group, .source');
        if (container) container.classList.toggle('collapsed');
      });

      if (sentinel) {
        const observer = new IntersectionObserver(
          async (entries) => {
            if (!entries[0].isIntersecting || loading) return;
            loading = true;
            try {
              const res = await fetch(`${base}/pages/${next}.html`);
              if (!res.ok) throw new Error(res.status);
              feed.insertAdjacentHTML('beforeend', await res.text());
              next++;
            } catch {
              observer.disconnect();
              sentinel.textContent = 'Tải lỗi. Reload trang.';
              return;
            } finally {
              loading = false;
            }
            if (next > total) {
              observer.disconnect();
              sentinel.remove();
            } else {
              // The sentinel may still be inside rootMargin after appending,
              // which fires no new callback. Re-observe to force a fresh check.
              observer.unobserve(sentinel);
              observer.observe(sentinel);
            }
          },
          { rootMargin: '600px' }
        );
        observer.observe(sentinel);
      }
    </script>

    <style is:global>
      @import url('../../tokens.css');

      * {
        box-sizing: border-box;
      }
      html,
      body {
        overflow-x: clip;
      }
      html {
        font-size: 18px;
      }
      body {
        max-width: 48rem;
        margin: 0 auto;
        padding: var(--space-xl) var(--space-md) var(--space-3xl);
        background: var(--color-paper);
        color: var(--color-ink);
        font-family: var(--font-body);
        font-size: var(--text-md);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      /* ——— Masthead — print, off-register ——— */
      .masthead {
        margin-bottom: var(--space-2xl);
        padding: var(--space-sm) 0 var(--space-lg);
        border-top: 3px solid var(--color-ink);
        border-bottom: 1px solid var(--color-ink);
      }
      .issue {
        margin: 0 0 var(--space-sm);
        font-family: var(--font-display);
        font-size: var(--text-sm);
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-ink-2);
      }
      .masthead h1 {
        position: relative;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(3rem, 11vw, 5.5rem);
        line-height: 0.88;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        color: var(--color-ink);
      }
      /* second pass, off-register — the rust ghost sits behind */
      .masthead h1::before {
        content: attr(data-text);
        position: absolute;
        left: 0.055em;
        top: 0.035em;
        color: var(--color-accent);
        pointer-events: none;
      }
      .count {
        margin: var(--space-md) 0 0;
        font-family: var(--font-display);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-ink-2);
      }

      /* ——— Day section head — numbered + double rule ——— */
      .day {
        margin-top: var(--space-2xl);
      }
      .day-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-sm);
        margin: 0 0 var(--space-lg);
        padding-bottom: var(--space-2xs);
        border-bottom: 2px solid var(--color-ink);
        box-shadow: 0 3px 0 0 var(--color-rule-strong);
        cursor: pointer;
        user-select: none;
      }
      .day-head::before {
        content: '▾';
        font-family: var(--font-display);
        font-size: var(--text-md);
        color: var(--color-ink-2);
        transition: transform var(--dur-short) var(--ease-out);
        flex-shrink: 0;
      }
      .day.collapsed .day-head::before {
        transform: rotate(-90deg);
      }
      .day.collapsed > .group {
        display: none;
      }
      .day-title {
        display: inline-flex;
        align-items: baseline;
        gap: var(--space-sm);
      }
      .day-no {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: var(--text-xl);
        color: var(--color-accent);
      }
      .day-date {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(var(--text-xl), 5vw, var(--text-2xl));
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      .day-count {
        margin-left: auto;
        color: var(--color-ink-2);
        font-family: var(--font-display);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      /* ——— Group — rust condensed caps kicker ——— */
      .group {
        margin-top: var(--space-xl);
      }
      .group-head {
        margin: 0 0 var(--space-md);
        padding-top: var(--space-2xs);
        border-top: 1px solid var(--color-rule);
        font-family: var(--font-display);
        font-size: var(--text-md);
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-accent);
        cursor: pointer;
        user-select: none;
      }
      .group-head::before {
        content: '▾';
        display: inline-block;
        margin-right: 0.5em;
        font-size: 0.75em;
        color: var(--color-ink-2);
        transition: transform var(--dur-short) var(--ease-out);
      }
      .group.collapsed .group-head::before {
        transform: rotate(-90deg);
      }
      .group.collapsed > .source {
        display: none;
      }

      /* ——— Source — umber serif byline ——— */
      .source {
        margin-top: var(--space-lg);
        margin-left: var(--space-md);
        padding-left: var(--space-sm);
        border-left: 2px solid var(--color-umber);
      }
      .source-head {
        margin: 0 0 var(--space-xs);
        font-family: var(--font-body);
        font-size: var(--text-md);
        font-weight: 600;
        color: var(--color-umber);
        cursor: pointer;
        user-select: none;
      }
      .source-head::before {
        content: '·';
        display: inline-block;
        margin-right: 0.5em;
        color: var(--color-ink-2);
        font-weight: 800;
      }
      .source.collapsed > .item {
        display: none;
      }

      /* ——— Items — ink content with rust rule ——— */
      .item {
        padding: var(--space-2xs) 0 var(--space-md);
      }
      .item .title {
        color: var(--color-ink);
        font-family: var(--font-body);
        font-size: var(--text-lg);
        font-weight: 600;
        line-height: 1.4;
        text-decoration: none;
        overflow-wrap: break-word;
        transition: color var(--dur-short) var(--ease-out);
      }
      .item .title::after {
        content: ' →';
        color: var(--color-accent);
        font-weight: 700;
      }
      .item .title:hover {
        color: var(--color-accent);
        text-decoration: underline;
        text-decoration-color: var(--color-accent);
        text-underline-offset: 4px;
      }
      .item .summary {
        max-width: 60ch;
        margin-top: var(--space-2xs);
        color: var(--color-ink-2);
        font-size: var(--text-md);
        line-height: 1.6;
        white-space: pre-line;
      }

      /* ——— Sentinel / colophon ——— */
      #sentinel {
        padding: var(--space-2xl) 0;
        color: var(--color-ink-3);
        font-family: var(--font-display);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-align: center;
      }
      footer {
        margin-top: var(--space-3xl);
        padding-top: var(--space-sm);
        border-top: 1px solid var(--color-ink);
        color: var(--color-ink-3);
        font-family: var(--font-display);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-align: center;
      }

      a:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 3px;
      }
      @media (prefers-reduced-motion: reduce) {
        .day-head::before,
        .group-head::before,
        .item .title {
          transition: none;
        }
      }
      @media (max-width: 400px) {
        .day-title {
          gap: var(--space-2xs);
        }
      }
    </style>
  </body>
</html>
